APP_NAME=shopease-order-service
APP_ENV=development
DEBUG=false
ORDER_SERVICE_PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-a-local-database-password
DB_NAME=shopease_order_db
# Compose uses this non-root MySQL account; local runs use DB_USER above.
ORDER_DB_USER=shopease

# Must match the Authentication Service's HS256 signing key. Never commit the real key.
JWT_SECRET_KEY=replace-with-the-auth-service-signing-key
JWT_ALGORITHM=HS256
AUTH_SERVICE_URL=

USER_SERVICE_URL=http://localhost:8001
USER_PROFILE_PATH_TEMPLATE=/api/users/{user_id}
USER_ADDRESS_PATH_TEMPLATE=/api/users/{user_id}/addresses/{address_id}
PRODUCT_SERVICE_URL=http://localhost:8002
PRODUCT_PATH_TEMPLATE=/api/products/{product_id}
INVENTORY_RESERVATIONS_PATH=/api/inventory/reservations
SERVICE_TIMEOUT_SECONDS=5

TAX_RATE=0.18
SHIPPING_CHARGE=50.00
